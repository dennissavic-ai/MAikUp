generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Users & Auth ────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

model User {
  id              String   @id @default(uuid())
  firebaseUid     String   @unique @map("firebase_uid")
  email           String   @unique
  displayName     String?  @map("display_name")
  photoUrl        String?  @map("photo_url")
  role            UserRole @default(USER)
  skinTone        String?  @map("skin_tone")
  skinUndertone   String?  @map("skin_undertone")
  faceShape       String?  @map("face_shape")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  subscription    Subscription?
  favorites       Favorite[]
  lookHistory     LookHistory[]
  savedLooks      SavedLook[]
  sharedLooks     SharedLook[]
  deviceTokens    DeviceToken[]

  @@map("users")
}

// ─── Subscriptions ───────────────────────────────────────────

enum SubscriptionTier {
  FREE
  BASIC
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  EXPIRED
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String             @unique @map("user_id")
  tier                 SubscriptionTier   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?            @unique @map("stripe_customer_id")
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")
  currentPeriodStart   DateTime?          @map("current_period_start")
  currentPeriodEnd     DateTime?          @map("current_period_end")
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ─── Makeup Catalog ──────────────────────────────────────────

enum MakeupCategory {
  FACE
  EYES
  LIPS
  CHEEKS
  BROWS
}

model MakeupProduct {
  id            String         @id @default(uuid())
  category      MakeupCategory
  subcategory   String
  name          String
  description   String?
  colorHex      String?        @map("color_hex")
  colorName     String?        @map("color_name")
  finish        String?
  intensity     String?
  imageUrl      String?        @map("image_url")
  thumbnailUrl  String?        @map("thumbnail_url")
  tier          SubscriptionTier @default(FREE)
  isActive      Boolean        @default(true) @map("is_active")
  sortOrder     Int            @default(0) @map("sort_order")
  tags          String[]       @default([])
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  favorites     Favorite[]
  lookProducts  LookProduct[]

  @@index([category, subcategory])
  @@index([tier])
  @@map("makeup_products")
}

// ─── Makeup Looks (Predefined Combinations) ──────────────────

model MakeupLook {
  id            String         @id @default(uuid())
  name          String
  description   String?
  style         String
  occasion      String?
  difficulty    String?
  imageUrl      String?        @map("image_url")
  thumbnailUrl  String?        @map("thumbnail_url")
  tier          SubscriptionTier @default(FREE)
  isActive      Boolean        @default(true) @map("is_active")
  sortOrder     Int            @default(0) @map("sort_order")
  tags          String[]       @default([])
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  products      LookProduct[]

  @@index([style])
  @@map("makeup_looks")
}

model LookProduct {
  id          String @id @default(uuid())
  lookId      String @map("look_id")
  productId   String @map("product_id")
  sortOrder   Int    @default(0) @map("sort_order")

  look    MakeupLook    @relation(fields: [lookId], references: [id], onDelete: Cascade)
  product MakeupProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([lookId, productId])
  @@map("look_products")
}

// ─── Hairstyle Catalog ───────────────────────────────────────

enum HairstyleCategory {
  CUT
  UPDO
  BRAID
  COLOR
  ACCESSORY
}

model Hairstyle {
  id            String            @id @default(uuid())
  category      HairstyleCategory
  subcategory   String
  name          String
  description   String?
  length        String?
  texture       String?
  colorHex      String?           @map("color_hex")
  colorName     String?           @map("color_name")
  imageUrl      String?           @map("image_url")
  thumbnailUrl  String?           @map("thumbnail_url")
  tier          SubscriptionTier  @default(FREE)
  isActive      Boolean           @default(true) @map("is_active")
  sortOrder     Int               @default(0) @map("sort_order")
  tags          String[]          @default([])
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  favorites     Favorite[]

  @@index([category, subcategory])
  @@index([tier])
  @@map("hairstyles")
}

// ─── User Interactions ───────────────────────────────────────

model Favorite {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  productId   String?  @map("product_id")
  hairstyleId String?  @map("hairstyle_id")
  createdAt   DateTime @default(now()) @map("created_at")

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   MakeupProduct? @relation(fields: [productId], references: [id], onDelete: Cascade)
  hairstyle Hairstyle?     @relation(fields: [hairstyleId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@unique([userId, hairstyleId])
  @@map("favorites")
}

model LookHistory {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  lookData  Json     @map("look_data")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("look_history")
}

model SavedLook {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  lookData  Json     @map("look_data")
  imageUrl  String?  @map("image_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  sharedLooks   SharedLook[]

  @@index([userId])
  @@map("saved_looks")
}

// ─── Social Sharing ──────────────────────────────────────────

model SharedLook {
  id          String   @id @default(uuid())
  savedLookId String   @map("saved_look_id")
  userId      String   @map("user_id")
  shareCode   String   @unique @map("share_code")
  isPublic    Boolean  @default(true) @map("is_public")
  viewCount   Int      @default(0) @map("view_count")
  createdAt   DateTime @default(now()) @map("created_at")

  savedLook SavedLook @relation(fields: [savedLookId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([shareCode])
  @@map("shared_looks")
}

// ─── Analytics ───────────────────────────────────────────────

model AnalyticsEvent {
  id        String   @id @default(uuid())
  eventType String   @map("event_type")  // "product_view", "look_try", "hairstyle_view", etc.
  entityId  String?  @map("entity_id")   // ID of the product/look/hairstyle
  entityType String? @map("entity_type") // "makeup_product", "makeup_look", "hairstyle"
  userId    String?  @map("user_id")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([eventType, entityId])
  @@index([entityType, createdAt])
  @@index([userId])
  @@map("analytics_events")
}

// ─── Push Notifications ──────────────────────────────────────

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  platform  String   // "android" or "ios"
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

// ─── Skin Tone Recommendations ───────────────────────────────

model SkinToneRecommendation {
  id            String @id @default(uuid())
  skinTone      String @map("skin_tone")      // "fair", "light", "medium", "olive", "tan", "deep", "very_deep"
  skinUndertone String @map("skin_undertone")  // "warm", "cool", "neutral"
  productId     String @map("product_id")
  matchScore    Float  @default(0.8) @map("match_score") // 0.0 - 1.0 how well it matches
  notes         String?

  @@unique([skinTone, skinUndertone, productId])
  @@index([skinTone, skinUndertone])
  @@map("skin_tone_recommendations")
}

// ─── AR Assets ───────────────────────────────────────────────

enum ArAssetType {
  MAKEUP_OVERLAY   // 2D texture overlay for makeup (eyeshadow, blush, lip color)
  FACE_MESH        // 3D face mesh modification (contour, highlight)
  HAIR_MODEL       // 3D hair model for hairstyle try-on
  ACCESSORY_MODEL  // 3D accessory model (hair clips, headbands)
}

model ArAsset {
  id            String      @id @default(uuid())
  productId     String?     @map("product_id")
  hairstyleId   String?     @map("hairstyle_id")
  assetType     ArAssetType @map("asset_type")
  modelUrl      String      @map("model_url")       // URL to 3D model file (.glb/.gltf)
  textureUrl    String?     @map("texture_url")      // URL to texture/overlay image
  thumbnailUrl  String?     @map("thumbnail_url")
  anchorPoint   String?     @map("anchor_point")     // Face landmark anchor: "lips", "left_eye", "right_eye", "nose", "forehead", "left_cheek", "right_cheek", "chin", "full_face", "head"
  blendMode     String?     @map("blend_mode")       // "multiply", "overlay", "screen", "normal"
  opacity       Float       @default(0.8)            // Default opacity 0.0-1.0
  scale         Json?                                // { x: 1.0, y: 1.0, z: 1.0 }
  offset        Json?                                // { x: 0, y: 0, z: 0 } offset from anchor
  metadata      Json?                                // Additional rendering params
  version       Int         @default(1)              // Asset version for cache busting
  fileSizeBytes Int?        @map("file_size_bytes")
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@index([productId])
  @@index([hairstyleId])
  @@index([assetType])
  @@map("ar_assets")
}

// ─── Featured / Trending ─────────────────────────────────────

enum FeaturedType {
  PRODUCT
  LOOK
  HAIRSTYLE
  COLLECTION
}

model FeaturedItem {
  id          String       @id @default(uuid())
  type        FeaturedType
  entityId    String       @map("entity_id")
  title       String
  subtitle    String?
  imageUrl    String?      @map("image_url")
  position    Int          @default(0)               // Display order
  section     String       @default("trending")      // "trending", "editors_pick", "new", "seasonal"
  startDate   DateTime?    @map("start_date")        // When to start showing
  endDate     DateTime?    @map("end_date")           // When to stop showing
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([section, isActive])
  @@index([type])
  @@map("featured_items")
}
